# Environment Variables for GannaHaat

# MySQL Database connection URL
DATABASE_URL="mysql://root:root@localhost:3306/gannahaat"

# Auth.js / NextAuth Secret
AUTH_SECRET="gannahaat_secure_secret_key_change_in_production_32chars"
NEXTAUTH_URL="http://localhost:3000"

# Mock OTP Mode (Default true for local development / testing)
MOCK_OTP_MODE="true"
MOCK_OTP_CODE="1234"
