// Prisma Schema for GannaHaat (गन्ना हाट)
// Sugarcane Bidding Platform for Rural India

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum BusinessType {
  SUGAR_MILL
  JAGGERY_CRUSHER_KOLHU
  KHANDSARI
  TRADER_COMMISSION_AGENT
}

enum HarvestStatus {
  STANDING_CROP        // खेत में खड़ी फसल
  FRESHLY_CUT          // आज का ताजा कटा हुआ
  CUT_WITHIN_24HRS     // 24 घंटे के अंदर का
}

enum ListingStatus {
  PENDING_APPROVAL     // एडमिन सत्यापन हेतु लंबित
  APPROVED             // लाइव मंडी में सक्रिय
  REJECTED             // एडमिन द्वारा अस्वीकृत
  SOLD                 // बोली स्वीकार हुई (सौदा पक्का)
  EXPIRED              // अवधि समाप्त
  CANCELLED            // किसान द्वारा रद्द
}

enum BidStatus {
  PENDING              // प्रतीक्षारत (किसान के निर्णय की प्रतीक्षा)
  ACCEPTED             // स्वीकृत (सौदा पक्का)
  REJECTED             // अस्वीकृत (अन्य बोली स्वीकार हुई या किसान ने अस्वीकार किया)
  WITHDRAWN            // खरीदार द्वारा वापस ली गई
}

model User {
  id            String         @id @default(cuid())
  phone         String         @unique @db.VarChar(15) // 10-digit Indian Mobile Number
  name          String         @db.VarChar(100)
  pinHash       String         @db.VarChar(255)        // Bcrypt hashed 4-digit PIN
  role          Role           @default(FARMER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  farmerProfile FarmerProfile?
  buyerProfile  BuyerProfile?
  listings      Listing[]      @relation("FarmerListings")
  bids          Bid[]          @relation("BuyerBids")
  approvedListings Listing[]   @relation("AdminApprovedListings")

  @@index([phone])
  @@index([role])
}

model FarmerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  village        String    @db.VarChar(100) // गाँव
  panchayat      String?   @db.VarChar(100) // ग्राम पंचायत
  tehsil         String    @db.VarChar(100) // तहसील / ब्लॉक
  district       String    @db.VarChar(100) // ज़िला
  state          String    @default("उत्तर प्रदेश") @db.VarChar(50)
  pincode        String?   @db.VarChar(10)
  totalLandAcres Decimal?  @db.Decimal(6, 2)
  kisanId        String?   @db.VarChar(50)  // किसान पहचान / पर्ची संख्या

  @@index([district])
}

model BuyerProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String       @db.VarChar(150) // फर्म / मिल / कोल्हू का नाम
  businessType BusinessType @default(JAGGERY_CRUSHER_KOLHU)
  gstin        String?      @db.VarChar(20)
  address      String       @db.VarChar(255)
  district     String       @db.VarChar(100) // ज़िला
  state        String       @default("उत्तर प्रदेश") @db.VarChar(50)

  @@index([district])
}

model Listing {
  id                  String        @id @default(cuid())
  farmerId            String
  farmer              User          @relation("FarmerListings", fields: [farmerId], references: [id], onDelete: Cascade)
  variety             String        @db.VarChar(100) // किस्म उदा. Co 0238, Co 0118
  quantityQuintals    Decimal       @db.Decimal(10, 2) // मात्रा क्विंटल में
  harvestStatus       HarvestStatus @default(STANDING_CROP)
  harvestDate         DateTime?     // अनुमानित कटाई तिथि
  basePricePerQuintal Decimal       @db.Decimal(8, 2)  // न्यूनतम भाव ₹/क्विंटल
  village             String        @db.VarChar(100)
  tehsil              String        @db.VarChar(100)
  district            String        @db.VarChar(100)
  landmark            String?       @db.VarChar(200)
  status              ListingStatus @default(PENDING_APPROVAL)
  rejectionReason     String?       @db.VarChar(255)
  approvedAt          DateTime?
  approvedById        String?
  approvedBy          User?         @relation("AdminApprovedListings", fields: [approvedById], references: [id], onDelete: SetNull)
  expiresAt           DateTime
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  bids                Bid[]

  @@index([district])
  @@index([variety])
  @@index([status])
  @@index([farmerId])
}

model Bid {
  id                 String    @id @default(cuid())
  listingId          String
  listing            Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId            String
  buyer              User      @relation("BuyerBids", fields: [buyerId], references: [id], onDelete: Cascade)
  bidPricePerQuintal Decimal   @db.Decimal(8, 2)  // बोली भाव ₹/क्विंटल
  totalAmount        Decimal   @db.Decimal(12, 2) // कुल अनुमानित राशि
  paymentTerms       String?   @db.VarChar(200)   // भुगतान शर्तें
  notes              String?   @db.VarChar(500)   // विशेष नोट
  status             BidStatus @default(PENDING)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}
